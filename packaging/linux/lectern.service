# Lectern as your own service (systemctl --user). Installed by packaging/linux/install.sh,
# which puts the install folder (~/.lectern) in place of @LECTERN_DIR@. Settings in
# @LECTERN_DIR@/lectern.env. It listens on 127.0.0.1 only: nginx on this machine is the way in.
#
# No ProtectSystem/ProtectHome/PrivateTmp/NoNewPrivileges here: in a user service they need
# user namespaces, and NoNewPrivileges breaks rootless Podman (its setuid newuidmap), which
# the chat's scripts run in. Those scripts are what's isolated: in a container, with only
# their project folder mounted.
[Unit]
Description=Lectern, a local AI workbench
After=network-online.target

[Service]
Type=simple
EnvironmentFile=@LECTERN_DIR@/lectern.env
ExecStart=@LECTERN_DIR@/app/venv/bin/lectern serve --no-browser --port ${LECTERN_PORT}
# Lectern stops its model runners on SIGINT, as on Ctrl+C.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
